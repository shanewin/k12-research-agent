TAVILY_API_KEY=your_tavily_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LINKEDIN_RAPIDAPI_KEY=your_rapidapi_key_here

# HubSpot service key or legacy private-app token (sent as Authorization: Bearer).
# Scopes: crm.objects.companies, crm.objects.contacts, crm.schemas.*, and notes (read+write).
# Create in the CRM portal: Settings > Integrations > Service Keys
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# USAC E-Rate open data (optional — E-Rate phase degrades gracefully without)
USAC_APP_TOKEN=optional
USAC_API_KEY_ID=optional
USAC_API_KEY_SECRET=optional
